# --- Application ---
NODE_ENV=development
PORT=8181
API_PREFIX=api
CORS_ORIGINS=*

# --- Database (Supabase / PostgreSQL) ---
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
# Append `?pgbouncer=true&connection_limit=1` for serverless / transaction-mode pools.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — used by Prisma Migrate for DDL.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Swagger ---
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Throttler (rate limiting) ---
THROTTLE_TTL=60000    # Time window in ms (60000 = 60 s).
THROTTLE_LIMIT=100    # Max requests allowed per window per IP.

# --- JWT ---
# Generate with: `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
JWT_SECRET="change-me-to-a-strong-random-string-min-32-chars"
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET="change-me-to-a-strong-random-string-min-32-chars"
JWT_REFRESH_EXPIRES_IN=7d

# --- Bcrypt ---
# 10 = ~10 hashes/sec on modern CPU. Increase for stronger but slower hashing.
BCRYPT_SALT_ROUNDS=10
