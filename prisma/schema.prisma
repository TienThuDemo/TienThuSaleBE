// Prisma schema file
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer / Supabase Pooler) used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct connection used by Prisma Migrate for DDL statements.
  directUrl = env("DIRECT_URL")
}

// Audit fields are duplicated across business entities since Prisma has no model
// inheritance. Keep them in sync with `BaseEntityFields` in `src/common/types/base-entity.ts`.
model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  name         String?
  phoneNumber  String? @map("phone_number")
  passwordHash String  @map("password_hash")

  // Audit
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdById String?   @db.Uuid @map("created_by_id")
  updatedById String?   @db.Uuid @map("updated_by_id")
  deletedById String?   @db.Uuid @map("deleted_by_id")

  refreshTokens RefreshToken[]

  @@index([deletedAt])
  @@map("users")
}

// Stateful refresh tokens — stored as sha256 hash so a DB leak does not yield
// usable tokens. `family` groups tokens issued during the same login session;
// detecting reuse of a rotated token revokes the entire family.
model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique @map("token_hash")
  family        String    @db.Uuid
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  userAgent     String?   @map("user_agent")
  ipAddress     String?   @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
